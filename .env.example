# LinkedIn Daily Growth Agent — Configuration Example
# ====================================================
# Copiez ce fichier sous le nom '.env' et complétez les champs :

# ── LinkedIn Official API (Optionnel si utilisation du mode Chrome CDP) ──
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_access_token_here
LINKEDIN_USER_ID=your_user_id_here

# ── Banque d'images Unsplash (Optionnel pour médias automatisés) ──
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# ── Google Gemini API (Pour la rédaction assistée par LLM) ──
GEMINI_API_KEY=your_gemini_api_key

# ── Paramètres de Sécurité & Quota ──
HARD_LIMIT_DAILY=25
DELAY_MIN_SECONDS=90
DELAY_MAX_SECONDS=180
TIMEZONE=Africa/Casablanca
